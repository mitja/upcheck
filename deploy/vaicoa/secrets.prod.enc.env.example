# The keys of secrets.prod.enc.env (production and staging) and secrets.twin.enc.env (twins), in
# plain text: a template only. The hub reads neither this file nor any unencrypted one. Fill in a copy
# OUTSIDE the repository, encrypt it with SOPS to the environment's age recipient, and commit only
# the .enc.env file (README, "Deploy on Vaicoa"). The values become the Podman secret upcheck-secrets.
#
# Django's secret key: python3 -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=REPLACE
# The database password; hex, so it can stand in DATABASE_URL unquoted: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE
# Optional: Polar billing (empty or absent: every monitor on the Free plan's rules)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_PRO=
POLAR_CHECKOUT_URL_PRO=
# Optional: the /metrics endpoint's bearer token, Mailjet for e-mail
METRICS_TOKEN=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
